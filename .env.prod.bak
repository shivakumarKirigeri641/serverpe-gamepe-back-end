# =============================================================================
# MastiPe back-end — PRODUCTION
# =============================================================================
# Live at https://api.mastipe.in, serving the site at https://mastipe.in.
#
# Loaded when NODE_ENV=production, or explicitly with:
#     npm run start:prod        (node --env-file=.env.prod dist/index.js)
#
# Every line marked CHANGE_ME must be set before this goes anywhere near a real
# player. Nothing here is a working value copied from development — a production
# server pointing at a laptop's database is the failure this file exists to
# prevent.
#
# NEVER COMMIT THIS FILE. It is in .gitignore; keep it that way.
# =============================================================================

# ---------- runtime ----------
NODE_ENV=production
PORT=5006
# 'info' in production: 'debug' logs every webhook body, which means players'
# message contents in the server log.
LOG_LEVEL=info

# ---------- postgres ----------
# CHANGE_ME — production database, its own user, its own password.
# Add ?sslmode=require if the database is not on the same host.
# The scheme must stay 'postgres://' — the driver discards it, but every other
# Postgres tool (psql, pg_dump, backups) requires it. The ROLE goes in the user
# slot, before the colon.
DATABASE_URL=postgres://serverpe:641641@localhost:5432/serverpe_gamepe

# ---------- redis ----------
# CHANGE_ME if Redis is password-protected: redis://:PASSWORD@localhost:6379
REDIS_URL=redis://localhost:6379

# ---------- whatsapp cloud api ----------
WHATSAPP_PHONE_NUMBER_ID=1292620167270529
WHATSAPP_BUSINESS_ACCOUNT_ID=2469850716833847
# CHANGE_ME — a PERMANENT System User token, not the 24-hour test token from the
# API Setup screen. The test token expires and the bot goes silent with no error
# anyone will notice until a player complains.
WHATSAPP_ACCESS_TOKEN=EAAOpEhxZCfxkBRg4x35l8svEBO0zZAcp3eM8SR9gqW0WROWONLsNmV2rCKgBQnPudkevH9F5ZAbWUZBAawLusHj4N5KBXRkdzeTKUCS3Cb1Y207jHsGU1pPq7LZB46oSbHwGRrYMD1D8UPkKLJhp83SbyaNIz42czjQL6ePJGyI6P5dznaqWcRXuZA6GM1oQZDZD
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=gamepe2026
WHATSAPP_APP_SECRET=da3a353220167fa8474cb2a4b72aef98

# MUST STAY EMPTY IN PRODUCTION.
#
# This is the development safety net that blocks sends to anyone not listed. If
# a number is left here, every real player is silently ignored — messages are
# recorded as failed and nobody is told why.
WHATSAPP_ALLOWED_RECIPIENTS=

WHATSAPP_FLOW_ID=

# ---------- monetization ----------
MONETIZATION_ENABLED=false
FREE_TRIAL_ENDS_AT=2026-09-06T23:59:59+05:30
DEFAULT_ENTRY_FEE_PAISE=0

APP_TIMEZONE=Asia/Kolkata
CONSENT_EVERY_GAME=false

# ---------- branding ----------
GEO_LOOKUP_ENABLED=true
SUPPORT_EMAIL=support@mastipe.in
BRAND_NAME=MastiPe
BRAND_TAGLINE="Play together, have Masti."

# ---------- public board ----------
# The origin players reach this server on. Board links, invite links and the
# brand image URLs are all built from it, so a wrong value here produces links
# that resolve to nothing.
PUBLIC_BASE_URL=https://api.mastipe.in
# CHANGE_ME — 64 random hex characters, and NOT the same value as any other
# secret here. Signs the board tokens that let a player open their ticket.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_BUSINESS_NUMBER=919739622631
PROMO_URL=https://quizpe.in
PROMO_TEXT="QuizPe is a WhatsApp-based daily revision quiz (Maths) for grades 1 to 10, for CBSE, ICSE and Karnataka State boards."
PROMO_SHARE_TEXT="Enrol your child for daily Maths revision on WhatsApp - grades 1 to 10, CBSE / ICSE / KA boards."

# ---------- routing ----------
API_BASE_PATH=/serverpe/platform/mastipe/v1
WHATSAPP_WEBHOOK_PATH=/public/users/bot/whatsapp/webhook
ADMIN_BASE_PATH=/admin
# Full webhook URL to paste into the Meta dashboard:
#   https://api.mastipe.in/serverpe/platform/mastipe/v1/public/users/bot/whatsapp/webhook

# ---------- admin api ----------
# CHANGE_ME — 64 random hex characters, different from BOARD_LINK_SECRET.
ADMIN_API_KEY=c8bfdd1085b3735ae7910308059a104f3aaa1d8ad346a9969d605845a58b8e13
BOARD_LINK_SECRET=9ca54ce44f0629d27c0100add1baa621cf7d2f956343479e808c1db92dc95842
# CHANGE_ME — do not ship the development passcode. This is the only thing
# between the internet and every player's phone number.
ADMIN_PASSCODE=6416
ADMIN_SESSION_TTL_MINUTES=120
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
# Only the admin panel's real origin. A localhost entry left here would let a
# page on a developer's machine call production with a stolen session token.
ADMIN_CORS_ORIGINS=https://admin.mastipe.in

# ---------- retention & housekeeping ----------
MESSAGE_BODY_RETENTION_DAYS=30
LOBBY_EXPIRY_MINUTES=60
GAME_STALL_MINUTES=30
MAINTENANCE_INTERVAL_MINUTES=15

# ---------- gameplay tuning ----------
DEFAULT_GAME_KEY=tambola
GAME_INACTIVITY_DRAWS=5
# Two, as the rules intend. One is a development convenience for testing a
# round alone and would let a player start a game against nobody.
MIN_PLAYERS_TO_START=2
EARLY_ADVANCE_DELAY_MS=300
DRAW_INTERVAL_SECONDS=20

# ---------- email alerts ----------
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_FROM_NAME=MastiPe
ADMIN_NOTIFICATIONS_ENABLED=true
NOREPLYMAIL=noreply@serverpe.in
# CHANGE_ME
NOREPLYMAIL_PASSWORD=ShivambngNo@22
ADMINMAIL=admin@serverpe.in
# CHANGE_ME
ADMINMAIL_PASSWORD=ShivambngAdm@22
ALERT_RECIPIENT=admin@serverpe.in
ALERT_DIGEST_MINUTES=10

# Empty in production: this is only used by the local smoke scripts.
TEST_PLAYER_WA_ID=

# ---------- payments (Razorpay) ----------
# Off until there are prices to charge. While false, no payment surface is shown
# to a player and the order endpoint refuses.
# Temporary "Test payment" row in the chat menu. Never true in production.
PAYMENT_TEST_MENU=false
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=rzp_live_TQpW0sHsKRa47E
RAZORPAY_KEY_SECRET=8TvAIgYWYWkbK63YiybU9th7
# Razorpay Dashboard > Settings > Webhooks. Signs every callback; without it a
# forged POST could credit somebody's wallet.
RAZORPAY_WEBHOOK_SECRET=
# Show plans that cannot be bought yet on the public site. False while pricing
# is undecided.
SHOW_UNAVAILABLE_PLANS=false
# Are the plan prices GST-inclusive, or is GST added on top?
GST_INCLUSIVE=true
GST_PERCENT=18
