# ─── MastiPe backend ────────────────────────────────────────────────────────
# Only these keys are read. Anything else in .env is ignored.

NODE_ENV=development
PORT=5006
LOG_LEVEL=debug                  # error | warn | info | debug

# Public origin that phones will reach. During ngrok testing this MUST be the
# ngrok https URL - never localhost, because board links are opened on phones.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

BRAND_NAME=MastiPe
APP_TIMEZONE=Asia/Kolkata
FREE_TRIAL_ENDS_AT=2026-09-06T23:59:59+05:30

# ─── Postgres ───────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=serverpe_gamepe
PGUSER=postgres
PGPASSWORD=

# ─── WhatsApp Cloud API ─────────────────────────────────────────────────────
# Leave WHATSAPP_ACCESS_TOKEN empty to run in dry-run mode: outbound messages
# are logged to the console instead of sent. A full round is playable offline.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_NUMBER=919739622631
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_PATH=/public/users/bot/whatsapp/webhook
# Safety net while testing: only these numbers can ever receive a message.
# Comma-separated. Leave empty to allow all (production).
WHATSAPP_ALLOWED_RECIPIENTS=

# ─── Security ───────────────────────────────────────────────────────────────
# Signs per-player board links. Any long random string; change it and all
# outstanding board links stop working.
BOARD_LINK_SECRET=

# ─── Game tuning ────────────────────────────────────────────────────────────
DRAW_INTERVAL_SECONDS=12
EARLY_ADVANCE_DELAY_MS=300
MIN_PLAYERS_TO_START=2
MAX_PLAYERS_PER_GAME=50
LOBBY_EXPIRY_MINUTES=60

# --- Location from IP (server-side; players are never asked for permission) ---
# Approximate: a mobile connection often resolves to the carrier gateway.
GEO_LOOKUP_ENABLED=false
GEO_PROVIDER=ip-api.com    # ip-api.com (http, 45/min, non-commercial) | ipinfo.io (https, needs key) | ipapi.co
GEO_API_KEY=

# --- Admin panel ---
ADMIN_BASE_PATH=/admin
ADMIN_PASSCODE=
ADMIN_SESSION_TTL_MINUTES=120
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
ADMIN_CORS_ORIGINS=
