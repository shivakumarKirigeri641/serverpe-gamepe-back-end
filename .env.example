# ---------------------------------------------------------------------------
# Copy to .env and fill in. Generated from the running configuration, so every
# key the server reads is listed here - a blank value means you must supply it.
#
# Secrets are intentionally empty. Never commit a filled-in .env.
# ---------------------------------------------------------------------------
# ---------- runtime ----------
NODE_ENV=development
PORT=5006
# Readable log lines instead of JSON. Handy on the server while watching a
# launch; turn off once you are shipping logs somewhere that parses them.
LOG_PRETTY=true
LOG_LEVEL=debug

# ---------- postgres ----------
DATABASE_URL=

# ---------- redis ----------
# 127.0.0.1, not localhost: Node resolves localhost to ::1 first, and a
# default Redis listens on IPv4 only — which fails as ECONNREFUSED ::1:6379
# while redis-cli on the same box answers PONG.
REDIS_URL=

# ---------- whatsapp cloud api ----------
# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# (optional, not read at runtime)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Any random string you also paste into the Meta webhook config screen
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify the X-Hub-Signature-256 header on inbound webhooks
WHATSAPP_APP_SECRET=
# Safety net: only these numbers may be messaged (comma-separated, E.164 no '+').
# Leave EMPTY in production. Set it while testing so a stray fixture cannot
# message a real person.
WHATSAPP_ALLOWED_RECIPIENTS=

# Published WhatsApp Flow id for the in-game board screen.
# Leave empty to fall back to a monospace ticket + reply buttons (no Flow setup needed).
WHATSAPP_FLOW_ID=

# ---------- monetization ----------
# Free trial until 2026-09-06 (7-day opt-in window). Flip to true to start
# charging entry fees.
#
# Short on purpose: the point of the first window is to find out how many people
# actually turn up, and a shorter one gives that answer sooner. Extend it from
# here once the signup count in the admin panel says whether it is worth it.
MONETIZATION_ENABLED=true
FREE_TRIAL_ENDS_AT=2026-09-06T23:59:59+05:30
DEFAULT_ENTRY_FEE_PAISE=0

# Timezone for all day/week boundaries and the Postgres session
APP_TIMEZONE=Asia/Kolkata

# Ask players to accept the terms before EVERY game (true) or only once (false)
CONSENT_EVERY_GAME=false

# ---------- branding ----------
# Product name players see in chat
# Where players report abuse and appeal a block
# Resolve approximate city/state from a board visitor's IP (third-party lookup)
GEO_LOOKUP_ENABLED=true
GEO_PROVIDER=ip-api.com
GEO_API_KEY=
SUPPORT_EMAIL=
BRAND_NAME=MastiPe
# One-line pitch shown under the name in the welcome message
BRAND_TAGLINE="Play together, have Masti."

# ---------- public board ----------
# Public https origin players reach this server on (your ngrok URL in dev).
# Board links cannot be built without it.
# The marketing site. Policy links in chat point here rather than at the API
# host, so a player sees mastipe.in. Leave empty to fall back to PUBLIC_BASE_URL.
SITE_BASE_URL=https://mastipe.in
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# Signing key for board links; falls back to WHATSAPP_APP_SECRET when empty
BOARD_LINK_SECRET=
# Your WhatsApp business number, for the "Back to WhatsApp" button
WHATSAPP_BUSINESS_NUMBER=
# Cross-promotion on the results screen
PROMO_URL=https://quizpe.in
PROMO_TEXT="QuizPe is a WhatsApp-based daily revision quiz (Maths) for grades 1 to 10, for CBSE, ICSE and Karnataka State boards."
# Forwardable line aimed at parents, sent under the promo button
PROMO_SHARE_TEXT="Enrol your child for daily Maths revision on WhatsApp - grades 1 to 10, CBSE / ICSE / KA boards."

# ---------- routing ----------
# Every route is mounted under this prefix.
API_BASE_PATH=/serverpe/platform/mastipe/v1
# Full webhook URL becomes API_BASE_PATH + WHATSAPP_WEBHOOK_PATH
WHATSAPP_WEBHOOK_PATH=/public/users/bot/whatsapp/webhook
ADMIN_BASE_PATH=/admin

# ---------- admin api ----------
# Bearer token your admin panel sends as: Authorization: Bearer <key>
# Leave empty to disable the admin API completely.
ADMIN_API_KEY=
# Passcode the admin panel logs in with (never sent to the browser in reverse)
ADMIN_PASSCODE=
# Session lifetime, failed-attempt limit and lockout
ADMIN_SESSION_TTL_MINUTES=120
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
# Comma-separated browser origins allowed to call it, e.g. http://localhost:5173
ADMIN_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- retention & housekeeping ----------
# Full message bodies are archived (not deleted) after this many days
MESSAGE_BODY_RETENTION_DAYS=30
# A lobby nobody started is cancelled after this long
LOBBY_EXPIRY_MINUTES=60
# A running game with no draw for this long is treated as stalled
GAME_STALL_MINUTES=30
# How often the maintenance job runs
MAINTENANCE_INTERVAL_MINUTES=15

# ---------- gameplay tuning ----------
# Which registered game 'play' starts by default
DEFAULT_GAME_KEY=
# Consecutive unanswered numbers before a game is treated as abandoned
GAME_INACTIVITY_DRAWS=5
# Minimum players before a host can start. Set to 1 to test a round alone.
MIN_PLAYERS_TO_START=2
# Pause after the last answer before the next number is drawn
EARLY_ADVANCE_DELAY_MS=300
# Seconds waited for player answers before the next number.
# A tick advances early as soon as everyone has answered.
# The largest room we accept. Set by delivery capacity, not by the game: a
# called number reaches every player as its own WhatsApp message, so a room
# bigger than the fan-out can serve inside one draw interval falls behind and
# never catches up. Raise it only after watching fanOutMs in the logs.
MAX_PLAYERS_PER_GAME=200
# How many of those messages are in flight at once.
DRAW_FANOUT_CONCURRENCY=8
DRAW_INTERVAL_SECONDS=12
START_COUNTDOWN_SECONDS=5
# ---------- email alerts ----------
# Alerts are SENT FROM the no-reply mailbox and delivered TO the admin mailbox.
# The admin password is not used for sending; it is here only because the
# mailbox is the same one support replies come into.
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_FROM_NAME=ServerPe App Solutions
ADMIN_NOTIFICATIONS_ENABLED=true
# Sender
NOREPLYMAIL=
NOREPLYMAIL_PASSWORD=
# Recipient
ADMINMAIL=
ADMINMAIL_PASSWORD=
ALERT_RECIPIENT=
# How often batched alerts are collected and sent as one digest
ALERT_DIGEST_MINUTES=10

# Your own number, for smoke-testing the send path (E.164, no '+')
TEST_PLAYER_WA_ID=

# ---------- sponsorships (QuizPe) ----------
# A MastiPe player sponsors a child's QuizPe subscription, pays QUIZPE — on
# QuizPe's Razorpay account, against a QuizPe invoice — and receives a promo
# code for a parent plus complimentary MastiPe access.
#
# MastiPe holds no Razorpay API keys for this and takes no money. It asks
# QuizPe to create the payment link, and hears from Razorpay that one was paid.
QUIZPE_API_URL=
# Signs our requests to QuizPe. Only permits asking for a payment link.
SPONSORSHIP_API_SECRET=
# QuizPe's Razorpay WEBHOOK secret — NOT its API key. It can only verify that a
# message came from Razorpay: it cannot charge, refund or read a payment.
QUIZPE_RAZORPAY_WEBHOOK_SECRET=
# Hidden while the free trial runs. Turn on to test before the trial ends.
SPONSORSHIPS_ENABLED=false

# ---------- payments (Razorpay) ----------
# Off until there are prices to charge. While false, no payment surface is shown
# to a player and the order endpoint refuses.
# Temporary "Test payment" row in the chat menu. Never true in production.
PAYMENT_TEST_MENU=true
PAYMENTS_ENABLED=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Settings > Webhooks. Signs every callback; without it a
# forged POST could credit somebody's wallet.
RAZORPAY_WEBHOOK_SECRET=
# Show plans that cannot be bought yet on the public site. False while pricing
# is undecided.
SHOW_UNAVAILABLE_PLANS=false
# Are the plan prices GST-inclusive, or is GST added on top?
GST_INCLUSIVE=true
GST_PERCENT=18

# --- Postgres (added: replaces DATABASE_URL) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=serverpe_gamepe
PGUSER=postgres
PGPASSWORD=

# --- Legal entity (marketing site footer + structured data) ---
# Leave blank until these are the real details - they appear publicly.
BUSINESS_LEGAL_NAME=ServerPe App Solutions
BUSINESS_ADDRESS_LINE1=
BUSINESS_ADDRESS_LINE2=
BUSINESS_CITY=
BUSINESS_STATE=
BUSINESS_POSTAL_CODE=
BUSINESS_COUNTRY=India
BUSINESS_GSTIN=
BUSINESS_PLACE_OF_SUPPLY=

# --- Sponsorship plan (placeholder, not on sale) ---
SPONSORSHIPS_ENABLED=false
SPONSORSHIP_PRICE_PAISE=9900          # 99 rupees
SPONSORSHIP_COMPLIMENTARY_HOURS=24    # clock starts at the first game, not at payment
SPONSORSHIP_PARTNER=QuizPe
DAILY_SUMMARY_HOUR=8

# Where the admin panel is served from. Used for the button on alert
# emails; leave blank and the button is left out.
ADMIN_PANEL_URL=
