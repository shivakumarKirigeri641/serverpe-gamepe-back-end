# ---------- runtime ----------
NODE_ENV=development
PORT=5009
LOG_LEVEL=debug

# ---------- postgres ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/serverpe_gamepe

# ---------- redis ----------
REDIS_URL=redis://localhost:6379

# ---------- whatsapp cloud api ----------
# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
# (optional, not read at runtime)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Any random string you also paste into the Meta webhook config screen
WHATSAPP_VERIFY_TOKEN=change-me
# App secret, used to verify the X-Hub-Signature-256 header on inbound webhooks
WHATSAPP_APP_SECRET=
# Safety net: only these numbers may be messaged (comma-separated, E.164 no '+').
# Leave EMPTY in production. Set it while testing so a stray fixture cannot
# message a real person.
WHATSAPP_ALLOWED_RECIPIENTS=

# Published WhatsApp Flow id for the in-game board screen.
# Leave empty to fall back to a monospace ticket + reply buttons (no Flow setup needed).
WHATSAPP_FLOW_ID=

# ---------- monetization ----------
# Free trial until 2026-09-14 (14-day opt-in window). Flip to true to start charging entry fees.
MONETIZATION_ENABLED=false
FREE_TRIAL_ENDS_AT=2026-09-14T23:59:59+05:30
DEFAULT_ENTRY_FEE_PAISE=0

# Your own number, for smoke-testing the send path (E.164, no '+')
TEST_PLAYER_WA_ID=

# Timezone for all day/week boundaries and the Postgres session
APP_TIMEZONE=Asia/Kolkata

# Ask players to accept the terms before EVERY game (true) or only once (false)
CONSENT_EVERY_GAME=false

# ---------- branding ----------
# Product name players see in chat
# Where players report abuse and appeal a block
# Resolve approximate city/state from a board visitor's IP (third-party lookup)
GEO_LOOKUP_ENABLED=true
SUPPORT_EMAIL=support@mastipe.in
BRAND_NAME=MastiPe
# One-line pitch shown under the name in the welcome message
BRAND_TAGLINE="Play together, have Masti."

# ---------- public board ----------
# Public https origin players reach this server on (your ngrok URL in dev).
# Board links cannot be built without it.
PUBLIC_BASE_URL=
# Signing key for board links; falls back to WHATSAPP_APP_SECRET when empty
BOARD_LINK_SECRET=
# Your WhatsApp business number, for the "Back to WhatsApp" button
WHATSAPP_BUSINESS_NUMBER=919739622631
# Cross-promotion on the results screen
PROMO_URL=https://quizpe.in
PROMO_TEXT="QuizPe is a WhatsApp-based daily revision quiz (Maths) for grades 1 to 10, for CBSE, ICSE and Karnataka State boards."
# Forwardable line aimed at parents, sent under the promo button
PROMO_SHARE_TEXT="Enrol your child for daily Maths revision on WhatsApp - grades 1 to 10, CBSE / ICSE / KA boards."

# ---------- routing ----------
# Every route is mounted under this prefix.
API_BASE_PATH=/serverpe/platform/mastipe/v1
# Full webhook URL becomes API_BASE_PATH + WHATSAPP_WEBHOOK_PATH
WHATSAPP_WEBHOOK_PATH=/public/users/bot/whatsapp/webhook
ADMIN_BASE_PATH=/admin

# ---------- admin api ----------
# Bearer token your admin panel sends as: Authorization: Bearer <key>
# Leave empty to disable the admin API completely.
ADMIN_API_KEY=
# Passcode the admin panel logs in with (never sent to the browser in reverse)
ADMIN_PASSCODE=6416
# Session lifetime, failed-attempt limit and lockout
ADMIN_SESSION_TTL_MINUTES=120
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
# Comma-separated browser origins allowed to call it, e.g. http://localhost:5173
ADMIN_CORS_ORIGINS=

# ---------- retention & housekeeping ----------
# Full message bodies are archived (not deleted) after this many days
MESSAGE_BODY_RETENTION_DAYS=30
# A lobby nobody started is cancelled after this long
LOBBY_EXPIRY_MINUTES=60
# A running game with no draw for this long is treated as stalled
GAME_STALL_MINUTES=30
# How often the maintenance job runs
MAINTENANCE_INTERVAL_MINUTES=15

# ---------- gameplay tuning ----------
# Which registered game 'play' starts by default
DEFAULT_GAME_KEY=tambola
# Consecutive unanswered numbers before a game is treated as abandoned
GAME_INACTIVITY_DRAWS=5
# Minimum players before a host can start. Set to 1 to test a round alone.
MIN_PLAYERS_TO_START=2
# Pause after the last answer before the next number is drawn
EARLY_ADVANCE_DELAY_MS=300
# Seconds waited for player answers before the next number.
# A tick advances early as soon as everyone has answered.
DRAW_INTERVAL_SECONDS=20

# ---------- email alerts ----------
# Alerts are sent FROM the no-reply mailbox TO the admin mailbox.
ADMINMAIL=
ADMINMAIL_PASSWORD=
ADMIN_NOTIFICATIONS_ENABLED=
ALERT_DIGEST_MINUTES=
ALERT_RECIPIENT=
MAIL_FROM_NAME=
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
NOREPLYMAIL=
NOREPLYMAIL_PASSWORD=

# ---------- payments (Razorpay) ----------
# Off until there are prices to charge. While false, no payment surface is shown
# to a player and the order endpoint refuses.
# Temporary "Test payment" row in the chat menu. Never true in production.
PAYMENT_TEST_MENU=
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard > Settings > Webhooks. Signs every callback; without it a
# forged POST could credit somebody's wallet.
RAZORPAY_WEBHOOK_SECRET=
# Show plans that cannot be bought yet on the public site. False while pricing
# is undecided.
SHOW_UNAVAILABLE_PLANS=false
# Are the plan prices GST-inclusive, or is GST added on top?
GST_INCLUSIVE=true
GST_PERCENT=18
