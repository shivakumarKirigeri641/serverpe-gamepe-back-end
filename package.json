{
  "name": "serverpe-gamepe-back-end",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp-based multi-game entertainment platform (Tambola first)",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "worker": "tsx src/workers/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:consent": "tsx scripts/smoke-consent.ts",
    "smoke:exit": "tsx scripts/smoke-exit.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "ffmpeg-static": "^5.3.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
